<ci:SpeechProviderControlBase x:Class="EdgeTTSFix.Controls.SpeechProviderSettingsControls.EdgeTtsFixSettingsControl"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                              mc:Ignorable="d"
                              d:DesignHeight="450"
                              d:DesignWidth="800">
    <StackPanel Spacing="1">
        <controls:SettingsExpanderItem Content="音色"
                                       Description="选择 Edge TTS 音色；如果列表中没有，请在下方填写 ShortName。">
            <controls:SettingsExpanderItem.Footer>
                <ComboBox Width="340"
                          ItemsSource="{Binding VoiceOptions}"
                          SelectedItem="{Binding Settings.Voice, Mode=TwoWay}"/>
            </controls:SettingsExpanderItem.Footer>
        </controls:SettingsExpanderItem>

        <controls:SettingsExpanderItem Content="自定义音色"
                                       Description="例如 zh-CN-XiaoxiaoNeural、zh-CN-YunxiNeural。">
            <controls:SettingsExpanderItem.Footer>
                <TextBox Width="340" Text="{Binding Settings.Voice, Mode=TwoWay}"/>
            </controls:SettingsExpanderItem.Footer>
        </controls:SettingsExpanderItem>

        <controls:SettingsExpanderItem Content="语速" Description="取值范围大约为 -50% ～ +100%。">
            <controls:SettingsExpanderItem.Footer>
                <ComboBox Width="160"
                          ItemsSource="{Binding RateOptions}"
                          SelectedItem="{Binding Settings.Rate, Mode=TwoWay}"/>
            </controls:SettingsExpanderItem.Footer>
        </controls:SettingsExpanderItem>

        <controls:SettingsExpanderItem Content="音量" Description="取值范围大约为 -50% ～ +50%。">
            <controls:SettingsExpanderItem.Footer>
                <ComboBox Width="160"
                          ItemsSource="{Binding VolumeOptions}"
                          SelectedItem="{Binding Settings.Volume, Mode=TwoWay}"/>
            </controls:SettingsExpanderItem.Footer>
        </controls:SettingsExpanderItem>

        <controls:SettingsExpanderItem Content="音调" Description="单位为 Hz，例如 +20Hz。">
            <controls:SettingsExpanderItem.Footer>
                <ComboBox Width="160"
                          ItemsSource="{Binding PitchOptions}"
                          SelectedItem="{Binding Settings.Pitch, Mode=TwoWay}"/>
            </controls:SettingsExpanderItem.Footer>
        </controls:SettingsExpanderItem>

        <controls:SettingsExpanderItem Content="语音缓存"
                                       Description="{Binding CacheFolderPath}">
            <controls:SettingsExpanderItem.Footer>
                <Button Content="清空缓存" Click="ClearCache_Click"/>
            </controls:SettingsExpanderItem.Footer>
        </controls:SettingsExpanderItem>
    </StackPanel>
</ci:SpeechProviderControlBase>
